{
    "name": "@secondbrain/agent-limitless",
    "version": "2.0.0",
    "main": "index.js",
    "license": "MIT",
    "description": "Limitless connector - idempotently ingests lifelogs into the raw source schema",
    "scripts": {
        "start": "node index.js",
        "dev": "node index.js",
        "fetch": "node cron/fetchLifelogs.js",
        "archive": "node cron/archiveLimitlessData.js",
        "init-db": "psql $DATABASE_URL < sql/schema.sql"
    },
    "dependencies": {
        "@secondbrain/db": "*",
        "@secondbrain/telemetry": "*",
        "axios": "^1.18.1",
        "dotenv": "^16.5.0",
        "node-cron": "^4.1.0",
        "pg": "^8.20.0"
    }
}
