# ── Required ──────────────────────────────────────────────────────────────────
# All other configuration is managed through the UI at /agents.
DATABASE_URL=postgresql://user:password@localhost:5432/secondbrain

# ── Optional: seed API keys on first startup ──────────────────────────────────
# These can also be added later via the UI (Agents → Config / LLM Providers).
# Once stored in the database these env vars are no longer consulted.
#
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-proj-...
# LIMITLESS_API_KEY=sk-...
# TAVILY_API_KEY=tvly-...
# SERPAPI_API_KEY=...
# PEOPLEDATALABS_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
#
# Gmail (email agent — also configurable via UI):
# GMAIL_EMAIL_1=you@gmail.com
# GMAIL_APP_PASSWORD_1=xxxx xxxx xxxx xxxx

# Apple Contacts: expand local phone numbers to E.164 during canonicalization.
# CONTACTS_DEFAULT_COUNTRY_CODE=91

# ── WhatsApp connector ────────────────────────────────────────────────────────
# CLIENT_ID is configured via the UI (Agents → WhatsApp → Config tab).
# WHATSAPP_PORT=3000          # HTTP port for the bridge admin UI (default: 3000)
# WHATSAPP_BIND_HOST=127.0.0.1 # Keep the bridge private; expose the main UI through Tailscale Serve
# WHATSAPP_SELF_JID=you@c.us  # Your own WhatsApp JID; used to exclude self chats
# WHATSAPP_MEDIA_ANALYSIS_BATCH=20
# WHATSAPP_MEDIA_ANALYSIS_INTERVAL_MS=10000

# ── Server port (default: 4001) ───────────────────────────────────────────────
# UI_PORT=4001
# API binds to loopback plus the discovered Tailscale IPv4 by default. Set this
# only when intentionally changing the bind policy (for example, in a local test).
# SECOND_BRAIN_BIND_HOST=127.0.0.1
# SECOND_BRAIN_TAILSCALE_IP=100.105.11.84 # optional override when auto-discovery is unavailable

# ── Remote access and privileged operations ──────────────────────────────────
# Comma-separated exact browser origins allowed to mutate data through the API.
# Add the HTTPS URL printed by `tailscale serve status` when using remote access.
# SECOND_BRAIN_ALLOWED_ORIGINS=https://your-mac.your-tailnet.ts.net
# For `npm run ui:dev`, Next.js also needs the remote development hostname.
# SECOND_BRAIN_ALLOWED_DEV_ORIGINS=your-mac.your-tailnet.ts.net
# Generate with: openssl rand -hex 32
# Deploy/reload stays disabled while this is unset.
# SECOND_BRAIN_DEPLOY_TOKEN=
